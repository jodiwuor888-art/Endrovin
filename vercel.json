{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "version": 2,
  "name": "joash-portfolio",

  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "publickey-credentials-get=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "cleanUrls": true,
  "trailingSlash": false,

  "public": true,

  "env": {
    "VITE_API_BASE_URL": "@api_base_url"
  },

  "build": {
    "env": {
      "VITE_API_BASE_URL": "@api_base_url"
    }
  },

  "outputDirectory": "frontendport",

  "routes": [
    { "src": "/admin/(.*)", "dest": "/frontendport/admin/$1" },
    { "src": "/",           "dest": "/frontendport/index.html" },
    {
      "src": "/(about|contact|projects|services|testimonials)\\.html",
      "dest": "/frontendport/$1.html"
    },
    { "src": "/(.*)",       "dest": "/frontendport/$1" }
  ]
}

#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Start Up Bash script for UN*X
# ----------------------------------------------------------------------------

if [ -z "$JAVA_HOME" ] ; then
  if [ -x "/usr/libexec/java_home" ] ; then
    JAVA_HOME=$(/usr/libexec/java_home)
    export JAVA_HOME
  fi
fi

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-}"
if [ -z "$MAVEN_PROJECTBASEDIR" ] ; then
  MAVEN_PROJECTBASEDIR="$(dirname "$(readlink -f "$0")")"
fi

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | sed "s/.*=//")
  WRAPPER_URL=$(grep "wrapperUrl" "$MAVEN_WRAPPER_PROPERTIES" | sed "s/.*=//")
fi

MAVEN_HOME="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-home"

if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  DOWNLOAD_URL="${DISTRIBUTION_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip}"
  TEMP_FILE=$(mktemp /tmp/apache-maven.XXXXXX.zip)
  echo "Downloading Apache Maven from $DOWNLOAD_URL ..."
  if command -v wget > /dev/null; then
    wget -q -O "$TEMP_FILE" "$DOWNLOAD_URL" || { echo "Failed to download Maven"; exit 1; }
  elif command -v curl > /dev/null; then
    curl -fsS -o "$TEMP_FILE" "$DOWNLOAD_URL" || { echo "Failed to download Maven"; exit 1; }
  else
    echo "Neither wget nor curl is available" >&2
    exit 1
  fi
  unzip -q "$TEMP_FILE" -d "$MAVEN_HOME"
  rm -f "$TEMP_FILE"
  MAVEN_HOME="$MAVEN_HOME/$(ls "$MAVEN_HOME" | head -1)"
else
  MAVEN_HOME="$MAVEN_HOME/$(ls "$MAVEN_HOME" | head -1)"
fi

CLASSWORLDS_CONF="$MAVEN_HOME/bin/m2.conf"
MAVEN_JAVA_EXE="${JAVA_HOME}/bin/java"

if [ ! -x "$MAVEN_JAVA_EXE" ]; then
  MAVEN_JAVA_EXE="java"
fi

exec "$MAVEN_JAVA_EXE" \
  $MAVEN_OPTS \
  $MAVEN_DEBUG_OPTS \
  -classpath "$MAVEN_HOME/boot/plexus-classworlds-*.jar" \
  "-Dclassworlds.conf=$CLASSWORLDS_CONF" \
  "-Dmaven.home=$MAVEN_HOME" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.codehaus.plexus.classworlds.launcher.Launcher "$@"

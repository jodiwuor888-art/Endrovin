# ============================================================
# .env.example — Environment Variable Template
# COPY THIS FILE to .env for local development
# NEVER commit a filled-in .env file to git
# ============================================================

# ── Spring Profile ──────────────────────────────────────────
# Use 'mysql' to connect to XAMPP or Aiven cloud MySQL
# Use 'prod' for Microsoft SQL Server
SPRING_PROFILES_ACTIVE=mysql

# ── Database Credentials ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PortfolioDB
DB_USER=root
DB_PASSWORD=

# ── JWT Authentication Secret ─────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=your_64_character_hex_secret_here_replace_this_before_production

# ── WebAuthn / Passkey ────────────────────────────────────────
# In production: use your actual domain (e.g. joash-portfolio.vercel.app)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portfolio Management System
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080,http://127.0.0.1:8080

# ── Upload Directory ─────────────────────────────────────────
UPLOAD_DIR=uploads

# ── CORS (comma-separated frontend origins) ──────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500

# ── Email (optional — for contact form alerts) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
ENABLE_EMAIL_NOTIFICATIONS=false

# ── Password Reset URL ───────────────────────────────────────
PASSWORD_RESET_URL=http://localhost:8080/admin/login.html

# ── JPA DDL ─────────────────────────────────────────────────
# Local: update  |  Production: validate
JPA_DDL_AUTO=update
